# Personal layer configuration for the self-contained fork.
# Copy to config/personal.env and edit. Never commit config/personal.env.

# Upstream (this fork's own database; created when the DSA app runs)
PERSONAL_UPSTREAM_DIR=.
PERSONAL_UPSTREAM_DB=./data/stock_analysis.db
PERSONAL_UPSTREAM_API=http://127.0.0.1:8000
PERSONAL_UPSTREAM_TIMEOUT=30

# Personal storage (separate from the upstream DB)
PERSONAL_DB=./data/personal.db
PERSONAL_DATA_DIR=./data

# Data sources (priority order)
PERSONAL_DATA_SOURCE_PRIORITY=tushare,baostock,akshare,tencent
TUSHARE_TOKEN=
# Empty = fall back to upstream STOCK_LIST / WebUI watchlist
PERSONAL_STOCK_LIST=600519,000001,510050

# Plugins
PERSONAL_PLUGINS_ENABLED=true
PERSONAL_PLUGIN_DIRS=./plugins
PERSONAL_PLUGIN_ALLOWLIST=

# Backtest
PERSONAL_BACKTEST_BENCHMARK=000300.SH
PERSONAL_BACKTEST_INITIAL_CASH=1000000
PERSONAL_BACKTEST_ADJUST=hfq

# Data quality: compare the primary source with a second source during sync
PERSONAL_CROSS_SOURCE_CHECK=true

# Local Tonghuashun screenshot OCR (no image leaves this machine)
PERSONAL_OCR_ENABLED=true
PERSONAL_OCR_MAX_IMAGE_MB=8

# Trade plan / portfolio risk defaults
PERSONAL_RISK_DEFAULT_BUDGET_PCT=1.0
PERSONAL_RISK_MAX_SINGLE_PCT=20.0
PERSONAL_RISK_MAX_TOP5_PCT=60.0
PERSONAL_RISK_MIN_CASH_PCT=5.0
PERSONAL_RISK_MAX_LIQUIDATION_DAYS=5.0
PERSONAL_RISK_MAX_CORRELATION=0.85

# QMT bridge (Windows machine on the LAN)
QMT_BRIDGE_URL=http://192.168.1.50:8710
QMT_BRIDGE_TOKEN=
QMT_TRADING_ENABLED=false
QMT_REQUIRE_CONFIRM=true

PERSONAL_LOG_LEVEL=INFO
