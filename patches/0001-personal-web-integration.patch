+function localToday(): string {
+  const value = new Date();
+  const offset = value.getTimezoneOffset() * 60_000;
+  return new Date(value.getTime() - offset).toISOString().slice(0, 10);
+}
+
+function emptyPosition(): EditablePosition {
+  return {
+    code: '',
+    name: '',
+    quantity: '',
+    available_quantity: '',
+    avg_cost: '',
+    market_price: '',
+    market_value: '',
+    pnl: '',
+  };
+}
