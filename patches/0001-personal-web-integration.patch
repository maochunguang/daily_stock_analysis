+  it('builds journal outcome query params', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(
+      jsonResponse({ rows: [], summary: {}, horizon: 20 }),
+    );
+    vi.stubGlobal('fetch', fetchMock);
+
+    await personalApi.journalOutcomes({
